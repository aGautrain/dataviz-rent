# Local development (npm run dev)
DATABASE_URL=postgres://dataviz:dataviz@localhost:5432/dataviz

# Production (docker compose on the VPS, see deploy/ansible)
# Loopback port nginx proxies to. Must be unique per project on the VPS.
APP_PORT=3100
POSTGRES_PASSWORD=change-me
# Comma-separated login:password pairs, one per tester.
BETA_USERS=mathys:change-me
# Shared secret the scheduler uses to trigger collections (openssl rand -hex 32).
CRON_SECRET=change-me
