# Copy to production.env (gitignored) and fill in. deploy.yml copies it to the
# server as /opt/dataviz-rent/.env, which docker compose reads.
APP_PORT=3100
POSTGRES_PASSWORD=change-me
# Comma-separated login:password pairs, one per tester.
BETA_USERS=mathys:change-me
# Shared secret the scheduler uses to trigger collections (openssl rand -hex 32).
CRON_SECRET=change-me
